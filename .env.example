FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
DATABASE_URL=sqlite:///pymes_ai.db
# auto (compatible con configuración anterior) | sqlite | postgresql
DATABASE_PROVIDER=sqlite
# PostgreSQL: postgresql+psycopg://usuario:clave@host:5432/base?sslmode=require
# Almacenamiento: local | s3 | azure
STORAGE_PROVIDER=local
STORAGE_PREFIX=codatau-demo
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=
# Alternativa sin connection string: DefaultAzureCredential con az login local,
# o AZURE_TENANT_ID, AZURE_CLIENT_ID y AZURE_CLIENT_SECRET en el servidor.
MAX_CONTENT_LENGTH=52428800
UPLOAD_FOLDER=uploads
ANALYTICS_FOLDER=artifacts
PROFILE_SAMPLE_SIZE=12
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# IA: disabled | openai_responses | openai_compatible
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# json_schema es preferido; json_object sirve como compatibilidad limitada.
AI_RESPONSE_MODE=json_schema
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_CANDIDATE_COLUMNS=8
AI_SAMPLE_VALUES=4
AI_CONTEXT_SAMPLE_ROWS=5
AI_CONTEXT_MAX_COLUMNS=80
