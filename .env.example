FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
DATABASE_URL=sqlite:///pymes_ai.db
MAX_CONTENT_LENGTH=52428800
UPLOAD_FOLDER=uploads
ANALYTICS_FOLDER=artifacts
PROFILE_SAMPLE_SIZE=12
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# IA: disabled | openai_responses | openai_compatible
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# json_schema es preferido; json_object sirve como compatibilidad limitada.
AI_RESPONSE_MODE=json_schema
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_CANDIDATE_COLUMNS=8
AI_SAMPLE_VALUES=4
